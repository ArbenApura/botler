<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- DEBUG ONLY: cleartext http is allowed to 10.0.2.2, localhost and 127.0.0.1 only (see res/xml/network_security_config.xml in this source set).
         The main manifest keeps usesCleartextTraffic false and names no network security config, so a release build refuses cleartext everywhere. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
