# Copy to .env ON THE SERVER (chmod 600) and fill in. Never commit the filled-in file. Passwords: letters and digits only (they go into SQL text).
POSTGRES_PASSWORD=
BOTLER_OWNER_PASSWORD=
BOTLER_RUNTIME_PASSWORD=

BOTLER_BASE_URL=https://botler.arbenger.com
# At least 32 characters. Signs sessions and encrypts the stored Google tokens: changing it signs everyone out
BETTER_AUTH_SECRET=

# Botler's own Google OAuth client. Redirect URI: https://botler.arbenger.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated Google emails that may sign in
ALLOWED_EMAILS=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 1 or 0: chat answers think first and the app shows the thinking (empty = 1)
DEEPSEEK_THINKING=

# Optional monthly token caps and the per-minute rate (blank = the defaults in src/env.ts)
BOTLER_CHAT_TOKEN_CAP=
BOTLER_MEMORY_TOKEN_CAP=
BOTLER_GLOBAL_TOKEN_CAP=
BOTLER_RATE_PER_MINUTE=

# Push through Firebase (P6.10). Leave both empty until the Firebase project exists. FCM_SERVICE_ACCOUNT is the service account JSON file, base64 encoded
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT=

# The PUBLIC key that encrypts nightly database dumps (age). The matching private key is kept OFF the server
BACKUP_AGE_RECIPIENT=

# Where the published Android builds live on the server (outside ~/botler so a deploy never deletes them). Default /srv/botler-releases
BOTLER_RELEASES_HOST_DIR=/srv/botler-releases
