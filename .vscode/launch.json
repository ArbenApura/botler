{
	"version": "0.2.0",
	"configurations": [
		{
			// Live server: F5 runs the debug app on the emulator against https://botler.arbenger.com with real Google sign in, so your real data shows.
			// Writes in the app are real writes to the live database. Needs app/.dev/live.json (git-ignored, holds the web client id) and the debug SHA-1 registered in Google.
			// This is the first entry, so it is the one F5 runs by default.
			"name": "Botler (emulator, live server)",
			"type": "dart",
			"request": "launch",
			"cwd": "app",
			"program": "lib/main.dart",
			"deviceId": "emulator-5554",
			"args": ["--dart-define-from-file=.dev/live.json"]
		},
		{
			// Local server: F5 runs the debug app on the emulator against the local server (yarn dev on 5280), signed in with the dev session.
			// Needs once per day: Docker Desktop up, `yarn dev:emulator` in server/, and `yarn dev:session` in server/ (see docs/ANDROID.md, "Live preview").
			"name": "Botler (emulator, local server)",
			"type": "dart",
			"request": "launch",
			"cwd": "app",
			"program": "lib/main.dart",
			"deviceId": "emulator-5554",
			"args": ["--dart-define-from-file=.dev/dev-session.json"]
		}
	]
}
