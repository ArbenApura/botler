# Copy to .env for local development. Never commit .env. Never put a real secret in this example.

# Botler's local Postgres (docker compose up -d in the repo root): port 5434, never AFB's 5433
DATABASE_URL=postgres://app_runtime:localruntimepassword@127.0.0.1:5434/botler
DATABASE_OWNER_URL=postgres://postgres:localpostgrespassword@127.0.0.1:5434/botler
BOTLER_AUTO_MIGRATE=1

# REQUIRED: the server stops at start when any of these is missing or blank
BOTLER_BASE_URL=http://localhost:5280
# At least 32 characters; also encrypts the stored Google tokens
BETTER_AUTH_SECRET=
# Botler web OAuth client (redirect http://localhost:5280/api/auth/callback/google for local work)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated Google emails that may sign in
ALLOWED_EMAILS=
DEEPSEEK_API_KEY=

# Optional (defaults in src/env.ts)
DEEPSEEK_MODEL=deepseek-flash
# 1 or 0: chat answers think first and the app shows the thinking (empty = 1)
DEEPSEEK_THINKING=
BOTLER_CHAT_TOKEN_CAP=
BOTLER_MEMORY_TOKEN_CAP=
BOTLER_GLOBAL_TOKEN_CAP=
BOTLER_RATE_PER_MINUTE=
