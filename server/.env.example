# Copy to .env for local development. Never commit .env. Never put a real secret in this example.

# Botler's local Postgres (docker compose up -d in the repo root): port 5434, never AFB's 5433
DATABASE_URL=postgres://app_runtime:localruntimepassword@127.0.0.1:5434/botler
DATABASE_OWNER_URL=postgres://postgres:localpostgrespassword@127.0.0.1:5434/botler
BOTLER_AUTO_MIGRATE=1

# REQUIRED: the server stops at start when any of these is missing or blank
BOTLER_BASE_URL=http://localhost:5280
# At least 32 characters; also encrypts the stored Google tokens
BETTER_AUTH_SECRET=
# Botler web OAuth client (redirect http://localhost:5280/api/auth/callback/google for local work)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated Google emails that may sign in
ALLOWED_EMAILS=

# The model provider the agent runs on. Only deepseek exists today (empty = deepseek)
MODEL_PROVIDER=deepseek
# The most tokens one chat model call may write, thinking and answer together (empty = 64000)
CHAT_MAX_TOKENS=
# How hard the chat model thinks: low, medium, high or max (empty = high)
CHAT_EFFORT=
# The most charged tokens one chat message may use over all its model calls, research helpers included (empty = 600000)
TURN_TOKEN_BUDGET=
# The context window the chat meter measures against, in tokens (empty = the host default, DeepSeek 1000000). Changes the meter only
CONTEXT_WINDOW_TOKENS=
# Research helper ceilings (runaway guards, not per message caps). Empty = 3 helpers at once, 6 tools at once, 12 rounds, 40 searches, 80 pages, 150000 tokens, 120 seconds
RESEARCH_CALLS_AT_ONCE=
RESEARCH_TOOL_PARALLEL=
RESEARCH_ROUNDS=
RESEARCH_SEARCHES=
RESEARCH_READS=
RESEARCH_CALL_TOKENS=
RESEARCH_SECONDS=
# The most tokens of earlier messages sent with a chat message, before the oldest drop and the chat is summarised (empty = 40000)
HISTORY_TOKENS=
# Required only when MODEL_PROVIDER=deepseek; accepted but unused otherwise
DEEPSEEK_API_KEY=
# The DeepSeek API address, https and without /v1; it also serves web search and page reading (empty = https://api.deepseek.com)
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-flash
# 1 or 0: chat answers think first and the app shows the thinking (empty = 1)
DEEPSEEK_THINKING=

# Optional (defaults in src/env.ts)
# Exchange rate feed (https only). Empty means https://open.er-api.com/v6/latest/USD
FX_RATES_URL=
# The folder that holds the published Android builds and latest.json, read-only (empty = /releases). A missing folder only turns the update check into "none"
BOTLER_RELEASES_DIR=
BOTLER_CHAT_TOKEN_CAP=
BOTLER_MEMORY_TOKEN_CAP=
BOTLER_GLOBAL_TOKEN_CAP=
BOTLER_RATE_PER_MINUTE=
