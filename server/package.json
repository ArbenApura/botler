{
	"name": "botler-server",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "yarn@4.18.1",
	"engines": {
		"node": ">=22"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --port 5280 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 5290 --strictPort",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"chat": "tsx scripts/chat.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"build:cli": "esbuild scripts/migrate.ts --bundle --platform=node --format=esm --packages=external --outfile=cli/migrate.mjs --log-level=warning",
		"deploy:vps": "powershell -ExecutionPolicy Bypass -File ../deploy/vps/deploy.ps1"
	},
	"dependencies": {
		"@huggingface/transformers": "^4.3.1",
		"better-auth": "^1.7.7",
		"decimal.js": "^10.6.0",
		"drizzle-orm": "^0.45.4",
		"drizzle-zod": "^0.8.3",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"age-encryption": "^0.3.1",
		"cross-env": "^10.1.0",
		"drizzle-kit": "^0.31.11",
		"esbuild": "0.28.2",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.4"
	}
}
